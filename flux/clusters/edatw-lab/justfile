# ArgoCD chart version, pinned in the deployment overlay's kustomize patch at
# ../../overlays/argocd/edatw-lab/kustomization.yaml (the base ships a floating range).
[doc("Bump the ArgoCD chart version pin to latest stable")]
bump-argocd:
    #!/usr/bin/env bash
    set -euo pipefail
    # argo-helm tags the argo-cd chart as argo-cd-<version>; releases are newest-first.
    ac=$(gh api 'repos/argoproj/argo-helm/releases?per_page=100' --jq '[.[].tag_name | select(startswith("argo-cd-"))] | first')
    ac="${ac#argo-cd-}"
    echo "==> ArgoCD chart: $ac"
    f="../../overlays/argocd/edatw-lab/kustomization.yaml"
    # Replace the value following the patch path (anchored so only this pin changes).
    AC="$ac" perl -0777 -pi -e 's{(path: /spec/chart/spec/version\s*\n\s*value:\s*)"[^"]*"}{$1"$ENV{AC}"}' "$f"
    echo "==> Updated $f"

# OpenEBS chart version, patched onto the remote base's HelmRelease in
