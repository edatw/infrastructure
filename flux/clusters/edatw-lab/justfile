# kagent chart version (kagent-crds + kagent), pinned directly in the EDA-repo
# base HelmReleases at flux/base/{kagent-crds,kagent}. Both charts are released
# in lockstep, so a single release tag drives both pins. Unlike the
# shangkuei-sourced components, this is a direct value, not a remote-base patch.
[doc("Bump the kagent chart version pin to latest stable")]
bump-kagent:
    #!/usr/bin/env bash
    set -euo pipefail
    # The kagent OCI chart version drops the leading v.
    ka=$(gh api repos/kagent-dev/kagent/releases/latest --jq .tag_name)
    ka="${ka#v}"
    echo "==> kagent chart: $ka"
    # Anchor on the chart name so only the chart.spec.version pin changes.
    KA="$ka" perl -0777 -pi -e 's{(chart: kagent-crds\s*\n\s*version:\s*)"[^"]*"}{$1"$ENV{KA}"}' ../../base/kagent-crds/helmrelease-kagent-crds.yaml
    KA="$ka" perl -0777 -pi -e 's{(chart: kagent\s*\n\s*version:\s*)"[^"]*"}{$1"$ENV{KA}"}' ../../base/kagent/helmrelease-kagent.yaml
    echo "==> Updated flux/base/kagent-crds + flux/base/kagent HelmReleases"

# OpenShell chart version, pinned directly in the flux/base/openshell HelmRelease.
# The chart is OCI-only (no GitHub release feed), so the version is read straight
# from the registry with `helm show chart`.
[doc("Bump the OpenShell chart version pin to latest stable")]
bump-openshell:
    #!/usr/bin/env bash
    set -euo pipefail
    # Official NVIDIA chart (oci://ghcr.io/nvidia/openshell, chart name helm-chart),
    # matching flux/base/openshell/helmrepository-openshell.yaml.
    os=$(helm show chart oci://ghcr.io/nvidia/openshell/helm-chart 2>/dev/null | awk '/^version:/{print $2; exit}')
    [ -n "$os" ] || { echo "failed to resolve OpenShell chart version" >&2; exit 1; }
    echo "==> OpenShell chart: $os"
    # Anchor on the chart name so only the chart.spec.version pin changes.
    OS="$os" perl -0777 -pi -e 's{(chart: helm-chart\s*\n\s*version:\s*)"[^"]*"}{$1"$ENV{OS}"}' ../../base/openshell/helmrelease-openshell.yaml
    echo "==> Updated flux/base/openshell HelmRelease"

# OpenClaw operator chart version, pinned directly in the
# flux/base/openclaw-operator HelmRelease. OCI-only chart (no GitHub release
# feed), so the version is read straight from the registry with `helm show chart`.
[doc("Bump the OpenClaw operator chart version pin to latest stable")]
bump-openclaw-operator:
