# Flux Cluster - edatw-lab
# Flux operations + SOPS-encrypted Kubernetes secret management.
# Uses the dedicated Flux age key (also wired into the cluster as flux-system/sops-age).

set shell := ["bash", "-euo", "pipefail", "-c"]

flux_namespace := "flux-system"
sops_age_key_file := env("HOME") / ".config/sops/age/edatw-lab-flux.txt"
secrets_dir := "secrets"

[doc("List recipes")]
default:
    @just --list --unsorted

# ============================================================================
# Flux Operations (use your ambient KUBECONFIG)
# ============================================================================

[doc("Force reconcile the git source and the cluster Kustomization")]
flux-reconcile:
    flux reconcile source git flux-system
    flux reconcile kustomization flux-system --with-source

[doc("Show GitRepository + Kustomization + HelmRelease status")]
flux-status:
    kubectl -n {{ flux_namespace }} get gitrepository flux-system || true
    @echo "---"
    kubectl -n {{ flux_namespace }} get kustomization
    @echo "---"
    kubectl get helmrelease -A

[doc("Tail Flux controller logs")]
flux-logs:
    flux logs --level=info --all-namespaces

# ============================================================================
# Component Version Bump
# ============================================================================

# Bump every component version pin to latest upstream stable. Each component has
# its own recipe below so they can be bumped independently; this runs them all.
[doc("Bump all component version pins to latest stable")]
bump-versions: bump-cert-manager bump-cilium bump-flux-operator bump-gateway-api

# Cilium chart version, patched onto the remote base in kustomization-cilium.yaml
# (and the documented pin in README.md). The Talos side pins it independently.
[doc("Bump the Cilium chart version pin to latest stable")]
bump-cilium:
    #!/usr/bin/env bash
    set -euo pipefail
    # stable.txt ships a leading v; the Helm chart version is unprefixed.
    cil=$(curl -fsSL https://raw.githubusercontent.com/cilium/cilium/main/stable.txt | tr -d '[:space:]')
    cil="${cil#v}"
    echo "==> Cilium chart: $cil"
    # Replace the value following the patch path (anchored so only this pin changes).
    CIL="$cil" perl -0777 -pi -e 's{(path: /spec/chart/spec/version\s*\n\s*value:\s*)"[^"]*"}{$1"$ENV{CIL}"}' kustomization-cilium.yaml
    CIL="$cil" perl -i -pe 's/(chart `)[^`]*(`)/$1$ENV{CIL}$2/' README.md
    echo "==> Updated kustomization-cilium.yaml, README.md"
    echo "NOTE: update the Talos pin to match:"
    echo "  - terraform/talos-cluster-edatw-lab/justfile   cilium_version := \"$cil\""

# Gateway API CRD version, patched onto the remote base's GitRepository in
# kustomization-gateway-api-source.yaml. The Talos side pins it independently.
[doc("Bump the Gateway API CRD version pin to latest stable")]
bump-gateway-api:
    #!/usr/bin/env bash
    set -euo pipefail
    # The GitRepository pins a git tag, which keeps the leading v.
    gw=$(gh api repos/kubernetes-sigs/gateway-api/releases/latest --jq .tag_name)
    gw="v${gw#v}"
    echo "==> Gateway API: $gw"
    # Replace the value following the patch path (anchored so only this pin changes).
    GW="$gw" perl -0777 -pi -e 's{(path: /spec/ref/tag\s*\n\s*value:\s*)"[^"]*"}{$1"$ENV{GW}"}' kustomization-gateway-api-source.yaml
    echo "==> Updated kustomization-gateway-api-source.yaml"
    echo "NOTE: update the Talos pin to match:"
    echo "  - terraform/modules/talos-cluster/main.tf      gateway_api_version = \"$gw\""

# cert-manager chart version, patched onto the remote base's HelmRelease in
# kustomization-cert-manager.yaml. The Terraform bootstrap pins it independently.
[doc("Bump the cert-manager chart version pin to latest stable")]
bump-cert-manager:
    #!/usr/bin/env bash
    set -euo pipefail
    # cert-manager chart versions keep the leading v.
    cm=$(gh api repos/cert-manager/cert-manager/releases/latest --jq .tag_name)
    cm="v${cm#v}"
    echo "==> cert-manager chart: $cm"
    # Replace the value following the patch path (anchored so only this pin changes).
    CM="$cm" perl -0777 -pi -e 's{(path: /spec/chart/spec/version\s*\n\s*value:\s*)"[^"]*"}{$1"$ENV{CM}"}' kustomization-cert-manager.yaml
    echo "==> Updated kustomization-cert-manager.yaml"
    echo "NOTE: keep the Terraform bootstrap pin in sync:"
    echo "  - terraform/gitops-edatw-lab  cert_manager_version = \"$cm\"  (just gitops-bump)"

# flux-operator chart version, patched onto the remote base's HelmRelease in
# kustomization-flux-operator.yaml. The Terraform bootstrap pins it independently.
[doc("Bump the flux-operator chart version pin to latest stable")]
bump-flux-operator:
    #!/usr/bin/env bash
    set -euo pipefail
    # The flux-operator chart version drops the leading v.
    fo=$(gh api repos/controlplaneio-fluxcd/flux-operator/releases/latest --jq .tag_name)
    fo="${fo#v}"
    echo "==> flux-operator chart: $fo"
    # Replace the value following the patch path (anchored so only this pin changes).
    FO="$fo" perl -0777 -pi -e 's{(path: /spec/chart/spec/version\s*\n\s*value:\s*)"[^"]*"}{$1"$ENV{FO}"}' kustomization-flux-operator.yaml
    echo "==> Updated kustomization-flux-operator.yaml"
    echo "NOTE: keep the Terraform bootstrap pin in sync:"
    echo "  - terraform/gitops-edatw-lab  flux_operator_version = \"$fo\"  (just gitops-bump)"

# ============================================================================
# SOPS Secret Management (encrypted with the Flux age key)
# ============================================================================

[doc("Create an encrypted Secret template (--name <n> --namespace <ns>)")]
[arg('name', long)]
[arg('namespace', long)]
secret-create name namespace:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{ secrets_dir }}"
    f="{{ secrets_dir }}/{{ name }}.enc.yaml"
    cat > "$f" <<EOF
    ---
    apiVersion: v1
    kind: Secret
    metadata:
      name: {{ name }}
      namespace: {{ namespace }}
    type: Opaque
    stringData:
      # add key: value pairs (encrypted on save)
    EOF
    "${EDITOR:-vim}" "$f"
    SOPS_AGE_KEY_FILE="{{ sops_age_key_file }}" sops --encrypt --in-place "$f"
    echo "Encrypted: $f  (add it to a kustomization.yaml resources list)"

[doc("Edit an encrypted secret in place (--file <path>)")]
[arg('file', long)]
secret-edit file:
    SOPS_AGE_KEY_FILE="{{ sops_age_key_file }}" sops "{{ file }}"

[doc("View a decrypted secret (--file <path>)")]
[arg('file', long)]
secret-view file:
    SOPS_AGE_KEY_FILE="{{ sops_age_key_file }}" sops -d "{{ file }}"

[doc("Validate that all *.enc.yaml secrets decrypt")]
sops-validate:
    #!/usr/bin/env bash
    set -euo pipefail
    fail=0
    while IFS= read -r f; do
        if SOPS_AGE_KEY_FILE="{{ sops_age_key_file }}" sops -d "$f" >/dev/null 2>&1; then
            echo "  [OK]   $f"
        else
            echo "  [FAIL] $f"; fail=1
        fi
    done < <(find . -name '*.enc.yaml')
    exit $fail
