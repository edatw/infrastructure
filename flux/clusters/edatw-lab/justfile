    echo "==> Updated flux/base/openclaw-operator HelmRelease"

# ============================================================================
# SOPS Secret Management
# ============================================================================
# Generic SOPS operations (sops-keygen, sops-init-config, sops-encrypt,
# sops-decrypt, sops-edit, sops-validate, sops-info, ...) come from the shared
# makefiles/sops.just module imported above. `secret-create` below is the only
# cluster-specific helper: it scaffolds a Kubernetes Secret then encrypts it
# with the shared Flux age key.

[doc("Scaffold + encrypt a Kubernetes Secret (--name <n> --namespace <ns>)")]
[arg('name', long)]
[arg('namespace', long)]
secret-create name namespace:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{ secrets_dir }}"
    f="{{ secrets_dir }}/{{ name }}.enc.yaml"
    cat > "$f" <<EOF
    ---
    apiVersion: v1
    kind: Secret
    metadata:
      name: {{ name }}
      namespace: {{ namespace }}
    type: Opaque
    stringData:
      # add key: value pairs (encrypted on save)
    EOF
    "${EDITOR:-vim}" "$f"
    SOPS_AGE_KEY_FILE="{{ sops_age_key_file }}" sops --encrypt --in-place "$f"
    echo "Encrypted: $f  (add it to a kustomization.yaml resources list)"
