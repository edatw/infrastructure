# ArgoCD deployment overlay - edatw-lab
# Generates a dedicated ArgoCD KSOPS age key and the argocd/sops-age secret
# (encrypted with the Flux age key so Flux can decrypt + deploy it to ArgoCD).
# After generating, uncomment secret-sops-age.enc.yaml in kustomization.yaml.

set shell := ["bash", "-euo", "pipefail", "-c"]

# Shared makefiles SOPS module: provides the Flux age key path (sops_age_key_file)
# and generic sops-* recipes. sops_env_name names the Flux key that ENCRYPTS the
# argocd/sops-age secret; `just sops-init-config` populates .sops.yaml with it.
sops_env_name := "flux-edatw-lab"

import '../../../../makefiles/sops.just'

# Dedicated ArgoCD KSOPS key (the secret CONTENT; encrypted with the Flux key).
argocd_key := env("HOME") / ".config/sops/age/argocd-edatw-lab.txt"
secret_file := "secret-sops-age.enc.yaml"

[doc("List recipes")]
default:
    @just --list --unsorted

[doc("Generate the dedicated ArgoCD KSOPS age key + encrypted argocd/sops-age secret")]
argocd-ksops:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f "{{ sops_age_key_file }}" ] || { echo "Missing flux key {{ sops_age_key_file }}"; exit 1; }
    mkdir -p "$(dirname "{{ argocd_key }}")"
    [ -f "{{ argocd_key }}" ] || age-keygen -o "{{ argocd_key }}"
    {
      echo "---"; echo "apiVersion: v1"; echo "kind: Secret"
      echo "metadata:"; echo "  name: sops-age"; echo "  namespace: argocd"
      echo "type: Opaque"; echo "stringData:"; echo "  keys.txt: |"
      sed 's/^/    /' "{{ argocd_key }}"
    } > "{{ secret_file }}"
    SOPS_AGE_KEY_FILE="{{ sops_age_key_file }}" sops --encrypt --in-place "{{ secret_file }}"
    echo "Encrypted {{ secret_file }} (argocd KSOPS key: {{ argocd_key }}) -- uncomment it in kustomization.yaml"
