# Flux Instance overlay - edatw-lab
# Generates the SOPS-encrypted secrets the FluxInstance overlay self-manages:
#   - sops-age              (flux-system/sops-age)        : Flux decryption key
#   - flux-system git creds (flux-system/flux-system)     : GitHub PAT
# These are ALSO created by the Terraform gitops-edatw-lab module on bootstrap;
# generating them here lets Flux own them going forward. After generating,
# uncomment the resources in kustomization.yaml and add the public key to .sops.yaml.

set shell := ["bash", "-euo", "pipefail", "-c"]

# Shared makefiles SOPS module: provides the Flux age key path (sops_age_key_file)
# and generic sops-* recipes. `just sops-init-config` generates the key and writes
# its public key into .sops.yaml.
sops_env_name := "flux-edatw-lab"

import '../../../../makefiles/sops.just'

sops_age_enc := "secret-sops-age.enc.yaml"
flux_git_enc := "secret-flux-git-credentials.enc.yaml"

[doc("List recipes")]
default:
    @just --list --unsorted

[doc("Generate + encrypt the flux-system/sops-age secret")]
secret-sops-age:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f "{{ sops_age_key_file }}" ] || { echo "Missing {{ sops_age_key_file }}"; exit 1; }
    {
      echo "---"; echo "apiVersion: v1"; echo "kind: Secret"
      echo "metadata:"; echo "  name: sops-age"; echo "  namespace: flux-system"
      echo "type: Opaque"; echo "stringData:"; echo "  age.agekey: |"
      sed 's/^/    /' "{{ sops_age_key_file }}"
    } > "{{ sops_age_enc }}"
    SOPS_AGE_KEY_FILE="{{ sops_age_key_file }}" sops --encrypt --in-place "{{ sops_age_enc }}"
    echo "Encrypted {{ sops_age_enc }} -- uncomment it in kustomization.yaml"

[doc("Generate + encrypt the flux-system git credentials secret (prompts)")]
secret-flux-git:
    #!/usr/bin/env bash
    set -euo pipefail
    read -rp "GitHub username: " u
    read -rsp "GitHub PAT: " p; echo
    {
      echo "---"; echo "apiVersion: v1"; echo "kind: Secret"
      echo "metadata:"; echo "  name: flux-system"; echo "  namespace: flux-system"
      echo "type: Opaque"; echo "stringData:"
      echo "  username: ${u}"; echo "  password: ${p}"
    } > "{{ flux_git_enc }}"
    SOPS_AGE_KEY_FILE="{{ sops_age_key_file }}" sops --encrypt --in-place "{{ flux_git_enc }}"
    echo "Encrypted {{ flux_git_enc }} -- uncomment it in kustomization.yaml"

[doc("Generate both secrets")]
setup: secret-sops-age secret-flux-git
