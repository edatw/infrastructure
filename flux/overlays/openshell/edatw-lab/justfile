# openshell overlay - edatw-lab
# Generates the SOPS-encrypted sandbox-JWT signing key the gateway needs
# (chart 0.0.71+). We run the chart's certgen hook disabled (pkiInitJob +
# certManager false, to keep our hand-rolled cert-manager ClusterIssuer TLS), so
# the JWT keypair is minted out-of-band with the gateway's own `generate-certs`
# and committed here, encrypted.

set shell := ["bash", "-euo", "pipefail", "-c"]

# Shared makefiles SOPS module: provides the Flux age key path (sops_age_key_file)
# and generic sops-* recipes. Reuses the edatw-lab Flux age key.
sops_env_name := "flux-edatw-lab"

import '../../../../makefiles/sops.just'

# Secret name must match server.sandboxJwt.signingSecretName in the base HelmRelease.
jwt_secret_name := "openshell-sandbox-jwt"
jwt_secret_file := "secret-openshell-sandbox-jwt.enc.yaml"

[doc("List recipes")]
default:
    @just --list --unsorted

[doc("Generate the sandbox-JWT signing key (gateway generate-certs) and SOPS-encrypt it")]
gen-jwt:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v docker >/dev/null || { echo "docker is required" >&2; exit 1; }
    # Match the gateway image to the chart version pinned in the base HelmRelease.
    hr="../../../base/openshell/helmrelease-openshell.yaml"
    ver=$(awk '/chart: helm-chart/{f=1} f&&/version:/{gsub(/"/,"",$2); print $2; exit}' "$hr")
    [ -n "$ver" ] || { echo "could not read chart version from $hr" >&2; exit 1; }
    img="ghcr.io/nvidia/openshell/gateway:${ver}"
    echo "==> minting sandbox-JWT keypair with $img"
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    # generate-certs writes via a temp dir + rename, so use a container-internal
    # output dir and docker cp it out (a bind mount fails the cross-device rename).
    cid=$(docker create --user 0:0 --entrypoint /usr/local/bin/openshell-gateway "$img" generate-certs --output-dir /tmp/pki)
    docker start -a "$cid" >/dev/null
    docker cp "$cid:/tmp/pki/jwt" "$tmp/jwt" >/dev/null
    docker rm "$cid" >/dev/null
    kid=$(cat "$tmp/jwt/kid")
    # Build the plaintext Secret (signing.pem / public.pem / kid).
    {
      echo "---"
      echo "# Sandbox-JWT signing key for the OpenShell gateway (chart 0.0.71+)."
      echo "# Generated by 'just gen-jwt'; referenced via server.sandboxJwt.signingSecretName."
      echo "apiVersion: v1"
      echo "kind: Secret"
      echo "metadata:"
      echo "  name: {{ jwt_secret_name }}"
      echo "  namespace: openshell"
      echo "type: Opaque"
      echo "stringData:"
      echo "  kid: \"${kid}\""
      echo "  signing.pem: |"
      sed 's/^/    /' "$tmp/jwt/signing.pem"
      echo "  public.pem: |"
      sed 's/^/    /' "$tmp/jwt/public.pem"
    } > "{{ jwt_secret_file }}"
    # Encrypt in place via the shared SOPS module (edatw-lab Flux age key).
    just sops-encrypt --file "{{ jwt_secret_file }}"
    echo "==> wrote + encrypted {{ jwt_secret_file }} (kid=${kid})"
