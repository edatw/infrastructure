# tailscale-operator overlay - edatw-lab
# Generates the SOPS-encrypted Tailscale OAuth client credentials the operator
# consumes (Secret `operator-oauth`, keys client_id/client_secret). The chart's
# oauth.* Helm values are left empty (base HelmRelease), so this pre-created
# secret is the credential source.
#
# One-time prep in the Tailscale admin console: create an OAuth client with
# `write` scope on Devices, Keys and Services, all tagged `tag:k8s-operator`,
# and add the tagOwners `tag:k8s-operator: []` and `tag:k8s: ["tag:k8s-operator"]`
# to the tailnet ACL.

set shell := ["bash", "-euo", "pipefail", "-c"]

# Shared makefiles SOPS module: provides the Flux age key path (sops_age_key_file)
# and generic sops-* recipes. Reuses the edatw-lab Flux age key.
sops_env_name := "flux-edatw-lab"

import '../../../../makefiles/sops.just'

# Secret name must match what the operator Deployment references (chart default).
oauth_secret_name := "operator-oauth"
oauth_secret_file := "secret-operator-oauth.enc.yaml"

[doc("List recipes")]
default:
    @just --list --unsorted

[doc("Write + SOPS-encrypt the Tailscale OAuth client secret (operator-oauth). Reads TS_OAUTH_CLIENT_ID/TS_OAUTH_CLIENT_SECRET from env, else prompts.")]
gen-oauth:
    #!/usr/bin/env bash
    set -euo pipefail
    cid="${TS_OAUTH_CLIENT_ID:-}"
    csec="${TS_OAUTH_CLIENT_SECRET:-}"
    if [ -z "$cid" ]; then read -rp "Tailscale OAuth client ID: " cid; fi
    if [ -z "$csec" ]; then read -rsp "Tailscale OAuth client secret: " csec; echo; fi
    [ -n "$cid" ] && [ -n "$csec" ] || { echo "client id and secret are required" >&2; exit 1; }
    {
      echo "---"
      echo "# Tailscale OAuth client credentials consumed by the operator."
      echo "# Generated by 'just gen-oauth'; the chart references Secret 'operator-oauth'"
      echo "# (keys client_id/client_secret) because oauth.* Helm values are empty."
      echo "apiVersion: v1"
      echo "kind: Secret"
      echo "metadata:"
      echo "  name: {{ oauth_secret_name }}"
      echo "  namespace: tailscale"
      echo "type: Opaque"
      echo "stringData:"
      echo "  client_id: \"${cid}\""
      echo "  client_secret: \"${csec}\""
    } > "{{ oauth_secret_file }}"
    just sops-encrypt --file "{{ oauth_secret_file }}"
    echo "==> wrote + encrypted {{ oauth_secret_file }}"
