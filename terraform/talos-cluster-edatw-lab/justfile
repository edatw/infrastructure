[doc("Complete cluster setup: init → apply → talos-apply → bootstrap → health")]
all: terraform-init terraform-apply (talos-apply "" "true" "") talos-bootstrap talos-health
    @echo ""
    @echo "Cluster deployment complete!"
    @echo "  export TALOSCONFIG=$(pwd)/{{ talosconfig }}"
    @echo "  export KUBECONFIG=$(pwd)/{{ kubeconfig }}"

[doc("Remove generated files and Terraform state")]
clean:
    rm -rf {{ generated_dir }} .terraform .terraform.lock.hcl
    rm -f terraform.tfstate terraform.tfstate.backup
    @echo "✓ Clean complete"

[doc("Show setup workflow")]
workflow:
    @echo ""
    @echo "SOPS + Terraform Setup Workflow"
    @echo "==============================="
    @echo ""
    @echo "1. Configure variables:"
    @echo "   cp {{ tfvars_example }} {{ tfvars_plain }}"
    @echo "   # Edit {{ tfvars_plain }}"
    @echo "   just sops-encrypt-tfvars && rm {{ tfvars_plain }}"
    @echo ""
    @echo "2. Configure backend:"
    @echo "   cp {{ backend_example }} {{ backend_hcl }}"
    @echo "   # Edit {{ backend_hcl }}"
    @echo "   just sops-encrypt-backend && rm {{ backend_hcl }}"
    @echo ""
    @echo "3. Deploy:"
    @echo "   just terraform-init"
    @echo "   just terraform-apply"
    @echo "   just talos-apply --insecure true"
    @echo "   just talos-bootstrap"
    @echo "   just talos-health"
