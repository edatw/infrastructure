# EDATW Cluster - Justfile
# Task runner for Talos Kubernetes cluster management with SOPS encryption

set shell := ["bash", "-euo", "pipefail", "-c"]

# ============================================================================
# Configuration
# ============================================================================

# Required by the shared makefiles modules (sops.just must be imported first)
sops_env_name := "talos-cluster-edatw-lab"

import '../../makefiles/sops.just'
import '../../makefiles/terraform.just'
import '../../makefiles/helm.just'
import '../../makefiles/talos.just'

cilium_namespace := "kube-system"
# Fallback Cilium chart version, used only when fetching the latest stable fails
# (cilium-install defaults to the latest stable from cilium's stable.txt).
cilium_version := "1.19.4"
cilium_values := generated_dir / "cilium-values.yaml"
# PodSecurity labels for the connectivity-test namespaces. Talos enforces
# 'baseline' outside kube-system, but the test pods need hostNetwork/hostPort/NET_RAW.
cilium_test_psa_labels := "pod-security.kubernetes.io/enforce=privileged,pod-security.kubernetes.io/warn=privileged,pod-security.kubernetes.io/audit=privileged"

# ============================================================================
# Default & Help
# ============================================================================

[doc("Show available recipes")]
default:
    @just --list --unsorted

# ============================================================================
# Cilium CNI
# ============================================================================

[arg('namespace', long='namespace')]
[arg('version', long='version')]
[doc("Install/upgrade Cilium CNI (latest stable by default; --version <ver> to pin, --namespace <ns>)")]
cilium-install namespace=cilium_namespace version="":
    #!/usr/bin/env bash
    set -euo pipefail
    version="{{ version }}"
    if [ -z "$version" ]; then
        # Cilium's blessed latest-stable (what `cilium install` reads). Strip the v.
        version=$(curl -fsSL https://raw.githubusercontent.com/cilium/cilium/main/stable.txt 2>/dev/null | tr -d '[:space:]' || true)
        version="${version#v}"
        if [ -z "$version" ]; then
            version="{{ cilium_version }}"
            echo "{{ _sops_yellow }}==> Could not fetch latest stable; using pinned {{ cilium_version }}{{ _sops_nc }}"
        else
            echo "{{ _sops_blue }}==> Latest stable Cilium: $version{{ _sops_nc }}"
        fi
    fi
    just helm-install cilium "{{ cilium_values }}" "{{ namespace }}" "$version"

[doc("Show Cilium status")]
cilium-status:
    KUBECONFIG="{{ kubeconfig }}" cilium status --wait

[doc("Run Cilium connectivity test (auto-labels test namespaces privileged for PodSecurity)")]
cilium-test:
    KUBECONFIG="{{ kubeconfig }}" cilium connectivity test --namespace-labels '{{ cilium_test_psa_labels }}'

[doc("Clean up Cilium connectivity test artifacts (namespaces, deployments, services)")]
cilium-test-cleanup:
    KUBECONFIG="{{ kubeconfig }}" cilium connectivity test --cleanup

# ============================================================================
# Workflow
# ============================================================================

[doc("Complete cluster setup: init → apply → talos-apply → bootstrap → health")]
all: tf-init (tf-apply "-auto-approve") (talos-apply "all" "--insecure") talos-bootstrap talos-health
    @echo ""
    @echo "Cluster deployment complete!"
    @echo "  export TALOSCONFIG=$(pwd)/{{ talosconfig }}"
    @echo "  export KUBECONFIG=$(pwd)/{{ kubeconfig }}"

alias clean := tf-clean

[doc("Show full setup workflow (terraform + talos + cilium)")]
workflow:
    @echo ""
    @echo "EDATW Lab Cluster - Setup Workflow"
    @echo "=================================="
    @echo ""
    @echo "1. Secrets (see also: just tf-workflow):"
    @echo "   cp {{ tf_tfvars_example }} {{ tf_tfvars_plain }}   # edit, then:"
    @echo "   just tf-encrypt-tfvars && rm {{ tf_tfvars_plain }}"
    @echo "   cp {{ tf_backend_example }} {{ tf_backend_hcl }}   # edit, then:"
    @echo "   just tf-encrypt-backend && rm {{ tf_backend_hcl }}"
    @echo ""
    @echo "2. Deploy:"
    @echo "   just tf-init && just tf-apply -auto-approve"
    @echo "   just talos-apply all --insecure   # all nodes; or: just talos-apply cp-01 --insecure"
    @echo "   just talos-bootstrap && just talos-health"
    @echo ""
    @echo "3. CNI:"
    @echo "   just cilium-install && just cilium-status"
