[doc("Check cluster health")]
talos-health:
    TALOSCONFIG="{{ talosconfig }}" talosctl health --wait-timeout={{ talos_wait_timeout }}

[doc("List cluster nodes")]
talos-nodes:
    KUBECONFIG="{{ kubeconfig }}" kubectl get nodes -o wide

[doc("List all pods")]
talos-pods:
    KUBECONFIG="{{ kubeconfig }}" kubectl get pods -A

[doc("Complete cluster status")]
talos-status: talos-health talos-nodes talos-pods

# ============================================================================
# Cilium CNI
# ============================================================================

[doc("Install/upgrade Cilium CNI via Helm (--namespace <ns> --version <ver>; uses generated cilium-values.yaml)")]
[arg('namespace', long)]
[arg('version', long)]
cilium-install namespace=cilium_namespace version=cilium_version:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{ cilium_values }}" ]; then
        echo "Error: {{ cilium_values }} not found. Run 'just terraform-apply' first."
        exit 1
    fi
    helm repo add cilium https://helm.cilium.io/ >/dev/null 2>&1 || true
    helm repo update cilium >/dev/null
    KUBECONFIG="{{ kubeconfig }}" helm upgrade --install cilium cilium/cilium \
        --namespace {{ namespace }} \
        --version {{ version }} \
        --values "{{ cilium_values }}" \
        --wait
    echo "✓ Cilium {{ version }} applied to {{ namespace }}"

[doc("Show Cilium status")]
cilium-status:
    KUBECONFIG="{{ kubeconfig }}" cilium status --wait

[doc("Run Cilium connectivity test (auto-labels test namespaces privileged for PodSecurity)")]
cilium-test:
    KUBECONFIG="{{ kubeconfig }}" cilium connectivity test --namespace-labels '{{ cilium_test_psa_labels }}'

[doc("Clean up Cilium connectivity test artifacts (namespaces, deployments, services)")]
cilium-test-cleanup:
    KUBECONFIG="{{ kubeconfig }}" cilium connectivity test --cleanup

